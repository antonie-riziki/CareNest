# Copy to Care_Nest/.env (never commit the copy)

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.vercel.app,https://carenest.vercel.app

# Postgres on Vercel (Neon). Leave empty locally to keep SQLite.
DATABASE_URL=

# Omega / ASI Alliance inference (OpenAI-compatible, same ASI_API_KEY convention as singnet/Omega)
ASI_API_KEY=
OMEGA_LLM_BASE_URL=https://llm.c.singularitynet.io/v1
OMEGA_LLM_MODEL=asi1-mini
OMEGA_LLM_ENABLED=true

# Optional existing USSD Gemini helper (unchanged)
GOOGLE_API_KEY=
AT_API_KEY=
AT_USERNAME=

# Stellar / Soroban testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_EXPLORER_BASE=https://stellar.expert/explorer/testnet

# Deployed WorkContract id (C...). Leave empty to run clearly-labelled DEMO DATA.
CARENEST_CONTRACT_ID=
CARENEST_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
CARENEST_TOKEN_SYMBOL=XLM
CARENEST_TOKEN_DECIMALS=7
CARENEST_FORCE_DEMO_MODE=false

# Optional server-held TESTNET keys for the guided demo only. Never mainnet. Never log these.
STELLAR_DEMO_EMPLOYER_SECRET=
STELLAR_DEMO_WORKER_SECRET=
STELLAR_ARBITER_SECRET=

# Supabase (server-side only — never commit real keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional Google Maps browser key (HTTP referrer restricted). Empty => Leaflet/OSM.
GOOGLE_MAPS_API_KEY=
MAP_PROVIDER=leaflet

CARENEST_PLATFORM_FEE_PERCENT=5
CARENEST_UPSKILLING_RECOVERY_PERCENT=20
PRICE_CACHE_SECONDS=60
PRICE_STALE_SECONDS=300
